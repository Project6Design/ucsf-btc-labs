<footer id="footer">
    <div class="container">
        <div class="footer__top">
            <div class="footer__logo">
                <img src="{{ footer_logo }}" alt="Logo Footer">
            </div>

            <nav id="footer-menu">
                {{ drupal_menu('footer', 1, 1) }}
            </nav>

            <div class="footer__social-links">
                <ul>
                    {% if twitter is not empty %}
                        <li>
                          <a href="{{ twitter }}" target="_blank" class="twitter-icon" aria-label="Twitter Link"></a>
                        </li>
                    {% endif %}
                    {% if facebook is not empty %}
                        <li>
                          <a href="{{ facebook }}" target="_blank" class="facebook-icon" aria-label="Facebook Link"></a>
                        </li>
                    {% endif %}
                    {% if instagram is not empty %}
                        <li>
                          <a href="{{ instagram }}" target="_blank" class="instagram-icon" aria-label="Instagram Link"></a>
                        </li>
                    {% endif %}
                    {% if youtube is not empty %}
                        <li>
                          <a href="{{ youtube }}" target="_blank" class="youtube-icon" aria-label="Youtube Link"></a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>

      <div class="footer__copyright">© {{ drupal_token('current-date:html_year') }} {{ copyright|raw }}</div>

        {{ page.footer }}
    </div>
</footer>

